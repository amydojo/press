{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "generation-api": {
      "root": "services/generation-api",
      "framework": "fastapi",
      "entrypoint": "src/press_generation_api/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/generation-api/(.*)",
      "destination": {
        "service": "generation-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
