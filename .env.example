# Shared runtime identity
PRESS_ENV=development
PRESS_VERSION=0.2.0

# Web server configuration
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Genblaze server only configuration
GENBLAZE_PROVIDER=openai
GENBLAZE_PROVIDER_API_KEY=
GENBLAZE_UNDERSTANDING_MODEL=gpt-4.1-mini
GENBLAZE_PRIMARY_MODEL=gpt-image-1
GENBLAZE_FALLBACK_MODEL=gpt-image-1-mini
GENBLAZE_IMAGE_SIZE=1024x1024
GENBLAZE_IMAGE_QUALITY=medium
GENERATION_TIMEOUT_SECONDS=120
MAX_GENERATION_ATTEMPTS=3

# Private Backblaze B2 S3 compatible storage. Never use NEXT_PUBLIC prefixes.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PRESIGNED_URL_LIFETIME_SECONDS=900
B2_CONNECT_TIMEOUT_SECONDS=30
B2_READ_TIMEOUT_SECONDS=300
B2_SDK_MAX_ATTEMPTS=3

# Validation and execution boundaries
MAX_SOURCE_BYTES=10485760
MAX_GENERATED_ASSET_BYTES=26214400
MIN_IMAGE_EDGE=512
MAX_IMAGE_EDGE=4096
FIXTURE_MODE=true
LIVE_INTEGRATION_TEST=false
LIVE_FORCE_RETRY_ONCE=false

# DEMO_MODE remains accepted as a compatibility alias for FIXTURE_MODE.
