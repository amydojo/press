{
  "components": {
    "schemas": {
      "CreatePressingRequest": {
        "additionalProperties": false,
        "properties": {
          "personalNote": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Personalnote",
            "type": "string"
          },
          "selectedFragment": {
            "minLength": 1,
            "title": "Selectedfragment",
            "type": "string"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType"
          },
          "sourceUploadId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceuploadid"
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceurl"
          }
        },
        "required": [
          "sourceType",
          "selectedFragment",
          "personalNote"
        ],
        "title": "CreatePressingRequest",
        "type": "object"
      },
      "FailureCategory": {
        "enum": [
          "invalid_source",
          "source_preparation_failed",
          "provider_authentication_failed",
          "provider_rate_limited",
          "provider_timed_out",
          "model_output_malformed",
          "asset_validation_failed",
          "storage_failed",
          "unknown_internal_error"
        ],
        "title": "FailureCategory",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "const": "press-generation-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment",
          "timestamp"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InternalArchetype": {
        "enum": [
          "scene",
          "relic",
          "signal"
        ],
        "title": "InternalArchetype",
        "type": "string"
      },
      "NotImplementedDetail": {
        "additionalProperties": false,
        "properties": {
          "arrivesIn": {
            "const": "PR 2",
            "title": "Arrivesin",
            "type": "string"
          },
          "code": {
            "const": "generation_not_implemented",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "arrivesIn"
        ],
        "title": "NotImplementedDetail",
        "type": "object"
      },
      "NotImplementedResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/NotImplementedDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "NotImplementedResponse",
        "type": "object"
      },
      "PressingRecord": {
        "additionalProperties": false,
        "properties": {
          "backAssetUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Backasseturl"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "failureCategory": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureCategory"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "failureMessage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Failuremessage"
          },
          "frontAssetUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Frontasseturl"
          },
          "generationModel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Generationmodel"
          },
          "generationProvider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Generationprovider"
          },
          "generationRunId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Generationrunid"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "internalArchetype": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InternalArchetype"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "parentRunId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parentrunid"
          },
          "personalNote": {
            "title": "Personalnote",
            "type": "string"
          },
          "selectedFragment": {
            "title": "Selectedfragment",
            "type": "string"
          },
          "serialNumber": {
            "title": "Serialnumber",
            "type": "string"
          },
          "sourceDomain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sourcedomain"
          },
          "sourceTitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sourcetitle"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType"
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sourceurl"
          },
          "status": {
            "$ref": "#/components/schemas/PressingStatus"
          },
          "thumbnailUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Thumbnailurl"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "serialNumber",
          "status",
          "sourceType",
          "selectedFragment",
          "personalNote",
          "createdAt",
          "updatedAt"
        ],
        "title": "PressingRecord",
        "type": "object"
      },
      "PressingStatus": {
        "enum": [
          "draft",
          "preparing_source",
          "understanding_fragment",
          "creating_world",
          "rendering_pressing",
          "saving_pressing",
          "ready",
          "failed"
        ],
        "title": "PressingStatus",
        "type": "string"
      },
      "SourceType": {
        "enum": [
          "url",
          "screenshot",
          "fixture"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "additionalProperties": false,
        "properties": {
          "buildTimestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buildtimestamp"
          },
          "commitSha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commitsha"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Typed service foundation for PRESS. Genblaze generation and Backblaze B2 persistence are explicitly deferred to PR 2.",
    "title": "PRESS Generation API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/pressings": {
      "post": {
        "operationId": "create_pressing_v1_pressings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePressingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplementedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplementedResponse"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "Create Pressing",
        "tags": [
          "pressings"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version",
        "tags": [
          "system"
        ]
      }
    }
  }
}
